# Pixel — local development secrets template (.dev.vars)
#
# Copy to `.dev.vars` for `wrangler dev`. `.dev.vars` is git-ignored and must
# never be committed. Values below are intentionally left EMPTY — fill them in
# locally only if the phase you are working on actually requires them.
# See docs/SECURITY_MODEL.md for the secret boundary rules.

# --- Non-secret (local overrides) ----------------------------------------------
# ENVIRONMENT=development
# LOG_LEVEL=debug
# APP_VERSION=1.28.0
# Phase 2A Telegram ingress flag (non-secret). Turn on locally ONLY together
# with the three Phase 2 secrets below (fake local fixtures are fine).
# TELEGRAM_INGRESS_ENABLED=false
# Phase 3 durable job/queue engine flag (non-secret; ADR-0036). Turn on
# locally only to exercise the engine against local D1 (no real queue is
# needed for offline tests; dispatch fails closed without the JOBS binding).
# JOBS_ENABLED=false
# Phase 5A editorial source→draft gate (non-secret; ADR-0042). Ships OFF:
# editorial.prepare_draft work is losslessly policy-paused while off; the
# AI service keeps its own independent gates.
# EDITORIAL_ENABLED=false
# Phase 5C-4 candidate-MATCHING report gate (V4 Phase 5.2): independent
# fail-closed flag; while off no candidateMatching payload is computed or
# stored; while on it is a pure zero-SQL/zero-cost derivation. Never
# implies EDITORIAL_ENABLED or AI_ENABLED.
# EDITORIAL_MATCHING_ENABLED=false
# EDITORIAL_ADJUDICATION_ENABLED=false
# Intended owner value since R1.10.5 (owner channel identity: pixel lores;
# non-secret per ADR-0009): TARGET_CHANNEL=@pixellores
# TARGET_CHANNEL=@pixellores
# Phase 6 AI adapter gates (non-secret; ADR-0041). Ships OFF: with
# AI_ENABLED=false the AI draft service never calls a provider.
# AI_GEMINI_ENABLED also requires verified Free-tier eligibility.
# AI_ENABLED=false
# AI_GEMINI_ENABLED=false
# R1.17 event-relation task gate (non-secret; ADR-0045). INDEPENDENT
# fail-closed flag: with false the relation step performs zero retrieval,
# zero adjudication, zero writes; never implies AI/EDITORIAL gates.
# EVENT_RELATION_ENABLED=false
# R1.18 read-only admin review gate (non-secret; ADR-0046). INDEPENDENT
# fail-closed flag for the /drafts read-only Telegram surface; ships OFF.
# ADMIN_REVIEW_ENABLED=false
# ADMIN_QUEUE_ENABLED=false
# R1.20-R admin post pipeline gates (independent, fail-closed; ship OFF):
# ADMIN_POST_ENABLED=false
# ADMIN_POST_LIVE_PUBLISH_ENABLED=false
# R1.22 Phase A editorial→post bridge gate (independent, fail-closed; ships
# OFF): gates ONLY /post_from_draft.
# EDITORIAL_TO_POST_ENABLED=false

# --- Secrets (names only; leave empty unless your phase requires them) ----------
# Phase 2 formats (ADR-0024):
#   BOT_TOKEN "<bot id>:<token body>", WEBHOOK_SECRET >= 32 chars
#   of [A-Za-z0-9_-], OWNER_TELEGRAM_ID positive decimal integer.
# BOT_TOKEN=
# WEBHOOK_SECRET=
# OWNER_TELEGRAM_ID=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# YOUTUBE_API_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# GITHUB_TOKEN=
# BLUESKY_APP_PASSWORD=
