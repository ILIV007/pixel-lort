{
  "schemaVersion": 1,
  "brand": {
    "channelName": "PIXEL LORT",
    "channelUsername": "@pixellort",
    "botPersona": "Pixel",
    "footerHtml": "<blockquote>👾 <a href=\"https://t.me/pixellort\">@pixellort</a></blockquote>"
  },
  "globalPolicies": {
    "timezone": "Asia/Tehran",
    "defaultPublishingMode": "auto",
    "rssConditionalGet": true,
    "respectRetryAfter": true,
    "maxRedirects": 2,
    "httpTimeoutMs": 10000,
    "maxFeedBytes": 2097152,
    "maxArticleBytes": 1048576,
    "allowHttp": false,
    "storeRawDays": 90,
    "neverAutoPublishSignalOnly": true,
    "noPiracyDownloadLinks": true,
    "youtubeDownloadForbidden": true
  },
  "sources": [
    {
      "id": "playstation_blog",
      "name": "PlayStation Blog",
      "connector": "rss",
      "lane": "official",
      "endpoint": "https://blog.playstation.com/feed/",
      "trustTier": 96,
      "intervalSeconds": 300,
      "dailyRequestBudget": 300,
      "approvalPolicy": "threshold",
      "autoPublishThreshold": 82,
      "content": ["official_news", "release", "trailer", "patch", "hardware"],
      "attribution": "PlayStation Blog"
    },
    {
      "id": "xbox_wire",
      "name": "Xbox Wire",
      "connector": "rss",
      "lane": "official",
      "endpoint": "https://news.xbox.com/en-us/feed/",
      "trustTier": 96,
      "intervalSeconds": 300,
      "dailyRequestBudget": 300,
      "approvalPolicy": "threshold",
      "autoPublishThreshold": 82,
      "content": ["official_news", "release", "trailer", "patch", "hardware"],
      "attribution": "Xbox Wire"
    },
    {
      "id": "steam_news_watchlist",
      "name": "Steam News Watchlist",
      "connector": "steam-news",
      "lane": "official",
      "endpoint": "https://api.steampowered.com/ISteamNews/GetNewsForApp/v2/",
      "trustTier": 92,
      "intervalSeconds": 600,
      "dailyRequestBudget": 500,
      "approvalPolicy": "threshold",
      "autoPublishThreshold": 84,
      "content": ["release", "patch", "dlc", "drm_update", "free_game"],
      "config": {"appsPerBatch": 10, "maxItemsPerApp": 3}
    },
    {
      "id": "youtube_official_watchlist",
      "name": "YouTube Official Channels",
      "connector": "youtube-playlists",
      "lane": "media",
      "endpoint": "https://www.googleapis.com/youtube/v3/playlistItems",
      "detailsEndpoint": "https://www.googleapis.com/youtube/v3/videos",
      "trustTier": 90,
      "intervalSeconds": 600,
      "dailyRequestBudget": 250,
      "approvalPolicy": "threshold",
      "autoPublishThreshold": 86,
      "content": ["trailer", "gameplay", "release"],
      "config": {"useSearchEndpoint": false, "downloadVideo": false}
    },
    {
      "id": "ign_games",
      "name": "IGN Games",
      "connector": "rss",
      "lane": "editorial",
      "endpoint": "https://www.ign.com/rss/v2/articles/feed?category=games",
      "trustTier": 84,
      "intervalSeconds": 900,
      "dailyRequestBudget": 150,
      "approvalPolicy": "threshold",
      "autoPublishThreshold": 88,
      "content": ["breaking", "industry", "release", "leak", "rumor", "hardware", "mobile"],
      "attribution": "IGN"
    },
    {
      "id": "eurogamer_news",
      "name": "Eurogamer News",
      "connector": "rss",
      "lane": "editorial",
      "endpoint": "https://www.eurogamer.net/feed/news",
      "trustTier": 86,
      "intervalSeconds": 900,
      "dailyRequestBudget": 150,
      "approvalPolicy": "threshold",
      "autoPublishThreshold": 88,
      "content": ["breaking", "industry", "release", "leak", "rumor"],
      "attribution": "Eurogamer"
    },
    {
      "id": "reddit_crack_signals",
      "name": "Reddit Crack Signals",
      "connector": "reddit-oauth",
      "lane": "radar",
      "endpointTemplate": "https://oauth.reddit.com/r/{subreddit}/new",
      "trustTier": 38,
      "intervalSeconds": 600,
      "dailyRequestBudget": 200,
      "approvalPolicy": "signal_only",
      "autoPublishThreshold": null,
      "content": ["crack_status", "drm_update"],
      "config": {"subreddits": ["CrackWatch"], "limit": 25, "stripDownloadLinks": true}
    },
    {
      "id": "reddit_leak_signals",
      "name": "Reddit Gaming Leak Signals",
      "connector": "reddit-oauth",
      "lane": "radar",
      "endpointTemplate": "https://oauth.reddit.com/r/{subreddit}/new",
      "trustTier": 32,
      "intervalSeconds": 600,
      "dailyRequestBudget": 200,
      "approvalPolicy": "signal_only",
      "autoPublishThreshold": null,
      "content": ["leak", "rumor"],
      "config": {"subreddits": ["GamingLeaksAndRumours"], "limit": 25}
    },
    {
      "id": "bluesky_watchlist",
      "name": "Bluesky Gaming Watchlist",
      "connector": "bluesky-public",
      "lane": "radar",
      "endpoint": "https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed",
      "trustTier": 45,
      "intervalSeconds": 600,
      "dailyRequestBudget": 250,
      "approvalPolicy": "signal_only",
      "autoPublishThreshold": null,
      "content": ["breaking", "leak", "rumor", "industry"],
      "config": {"accounts": [], "reposts": false, "replies": false}
    },
    {
      "id": "github_release_watchlist",
      "name": "GitHub Releases Watchlist",
      "connector": "github-releases",
      "lane": "official",
      "endpointTemplate": "https://api.github.com/repos/{owner}/{repo}/releases",
      "trustTier": 88,
      "intervalSeconds": 900,
      "dailyRequestBudget": 300,
      "approvalPolicy": "threshold",
      "autoPublishThreshold": 84,
      "content": ["emulator", "homebrew", "jailbreak", "mod"],
      "config": {"repositories": [], "includePrereleases": false}
    },
    {
      "id": "moddb_news",
      "name": "Mod DB News",
      "connector": "rss",
      "lane": "community",
      "endpoint": "https://rss.moddb.com/news/feed/rss.xml",
      "trustTier": 70,
      "intervalSeconds": 1800,
      "dailyRequestBudget": 80,
      "approvalPolicy": "threshold",
      "autoPublishThreshold": 88,
      "content": ["mod"],
      "attribution": "Mod DB"
    },
    {
      "id": "moddb_headlines",
      "name": "Mod DB Headlines",
      "connector": "rss",
      "lane": "community",
      "endpoint": "https://rss.moddb.com/headlines/feed/rss.xml",
      "trustTier": 76,
      "intervalSeconds": 1800,
      "dailyRequestBudget": 80,
      "approvalPolicy": "threshold",
      "autoPublishThreshold": 86,
      "content": ["mod"],
      "attribution": "Mod DB"
    },
    {
      "id": "itch_discovery",
      "name": "itch.io Discovery",
      "connector": "rss",
      "lane": "community",
      "endpointTemplates": [
        "https://itch.io/games/newest.xml",
        "https://itch.io/games/newest/price-free.xml"
      ],
      "trustTier": 66,
      "intervalSeconds": 3600,
      "dailyRequestBudget": 50,
      "approvalPolicy": "threshold",
      "autoPublishThreshold": 90,
      "content": ["indie", "free_game", "mobile"],
      "attribution": "itch.io"
    },
    {
      "id": "igdb_metadata",
      "name": "IGDB Metadata",
      "connector": "igdb",
      "lane": "metadata",
      "endpoint": "https://api.igdb.com/v4/",
      "trustTier": 86,
      "intervalSeconds": 86400,
      "dailyRequestBudget": 500,
      "approvalPolicy": "never_publish",
      "autoPublishThreshold": null,
      "content": [],
      "config": {"commercialUseAllowed": false, "requestsPerSecond": 4, "onDemand": true}
    }
  ]
}
