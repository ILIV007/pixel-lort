// wrangler.jsonc — Cloudflare Workers configuration for Pixel.
//
// PHASE 0 BOUNDARY (docs/ROADMAP.md):
//   - No Cloudflare resources are created or bound during Phase 0.
//   - No deployments are performed from this repository during Phase 0.
//   - Future bindings are documented below as commented placeholders with the
//     exact binding names fixed by the blueprint (docs/blueprint/v1/).
//
// Secret values must NEVER appear in this file. Use `wrangler secret put <NAME>`
// (or the dashboard) for deployed secrets and a git-ignored `.dev.vars` file for
// local development. See docs/SECURITY_MODEL.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixel",
  "main": "src/entrypoints/worker.ts",
  "compatibility_date": "2025-09-15",
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_VERSION": "1.3.0",
    "ENVIRONMENT": "development",
    "LOG_LEVEL": "info",
    // Phase 1A build/schema metadata (non-secret — ADR-0020). APP_COMMIT is
    // replaced by the real commit identifier at deploy time in later phases;
    // SCHEMA_VERSION is validated as a strict positive decimal integer.
    "APP_COMMIT": "local-dev",
    "SCHEMA_VERSION": "3",
    // Phase 2A Telegram ingress flag (non-secret; ADR-0024). The webhook
    // route fails closed unless this is "true" AND the Phase 2 secrets are
    // configured (BOT_TOKEN / WEBHOOK_SECRET / OWNER_TELEGRAM_ID via
    // `wrangler secret put` ONLY — never as vars). Left "false" in Phase 2A:
    // no Cloudflare secrets are configured and no webhook is registered.
    "TELEGRAM_INGRESS_ENABLED": "false",
    // Phase 3 durable job/queue engine flag (non-secret; ADR-0036). The cron
    // dispatch and queue consumer paths are active ONLY while this is "true"
    // AND the required bindings exist (missing bindings fail closed — never
    // a partial or ack-all path). Ships "false": no queue resources are
    // provisioned by the Phase 3 implementation pass (operator runbook only).
    "JOBS_ENABLED": "false",
  },

  // ---------------------------------------------------------------------------
  // Phase 1A — D1 binding declaration (LOCAL PLACEHOLDER ONLY, ADR-0019).
  //
  // This declaration enables LOCAL development and offline test tooling
  // (`wrangler d1 migrations` against local SQLite state, and the
  // vitest/workerd D1 test environment). NO Cloudflare resource exists or is
  // created: `database_id` is a syntactic placeholder until Phase 1B
  // provisioning, and remote migration commands remain documentation-only in
  // Phase 1A (docs/ROADMAP.md). Production/preview resource names are fixed
  // by ADR-0016: pixel-db-production | pixel-db-preview.
  // ---------------------------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pixel-db-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],

  // ---------------------------------------------------------------------------
  // Phase 3 — cron schedule for bounded due-work dispatch (ADR-0036;
  // blueprint §2 "Cron */5"). The scheduled handler performs NO work while
  // JOBS_ENABLED is "false" (structured no-op), so this trigger is safe to
  // declare before queue activation. Cron triggers are top-level (not
  // environment-overridable).
  // ---------------------------------------------------------------------------
  "triggers": {
    "crons": ["*/5 * * * *"],
  },

  // ---------------------------------------------------------------------------
  // Future bindings (planned — declared per phase, never before their phase).
  // The typed contract for all of these lives in src/shared/types/env.ts.
  // Planned RESOURCE names (ADR-0016): production `*-production`, preview
  // `*-preview` (Workers: `pixel` / `pixel-preview`). NOTHING beyond the
  // Phase 1A local D1 placeholder above is created or bound; creation
  // requires explicit owner approval.
  // ---------------------------------------------------------------------------
  //
  // Phase 1B (resource provisioning) — real D1 resources replace the local
  // placeholder above per ADR-0016.
  //
  // Phase 1 (repository, bindings and migrations) — KV cache namespace:
  // "kv_namespaces": [
  //   { "binding": "CACHE", "id": "<assigned-at-creation>" }  // pixel-cache-production | pixel-cache-preview
  // ],
  //
  // Phase 3 (job/queue framework) — Preview bindings are DECLARED in the
  // preview env below (JOBS/DLQ producers + consumer with DLQ, resource
  // names pixel-jobs-preview / pixel-dlq-preview per ADR-0016). Production
  // remains future-only until its own release gate:
  // "queues": {
  //   "producers": [{ "binding": "JOBS", "queue": "pixel-jobs-production" }],
  //   "consumers": [{ "queue": "pixel-jobs-production", "dead_letter_queue": "pixel-dlq-production" }]
  // },
  //
  // Phase 7 (media engine) — R2 bucket for temporary rights-cleared media:
  // "r2_buckets": [
  //   { "binding": "MEDIA", "bucket_name": "pixel-media-production" }  // preview: pixel-media-preview
  // ],
  //
  // Phase 6 (AI adapters) — Workers AI binding:
  // "ai": { "binding": "AI" }

  // ---------------------------------------------------------------------------
  // Phase 1B — provisioned preview environment.
  // Production remains unprovisioned until a later release gate.
  // APP_COMMIT is overridden with the exact Git SHA at deploy time.
  // ---------------------------------------------------------------------------
  "env": {
    "preview": {
      "name": "pixel-preview",
      "vars": {
        "APP_VERSION": "1.3.0",
        "ENVIRONMENT": "preview",
        "LOG_LEVEL": "info",
        "APP_COMMIT": "local-dev",
        "SCHEMA_VERSION": "3",
        // Owner-authorized Preview live wiring. Secret VALUES remain in
        // Cloudflare only: BOT_TOKEN, WEBHOOK_SECRET, OWNER_TELEGRAM_ID.
        // Production is unchanged; local defaults above remain disabled.
        "TELEGRAM_INGRESS_ENABLED": "true",
        // Phase 3 engine flag stays "false" until the operator runbook
        // provisions pixel-jobs-preview / pixel-dlq-preview and review
        // approves activation (ADR-0036 §7 — fail closed).
        "JOBS_ENABLED": "false",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pixel-db-preview",
          "database_id": "0212653a-b989-4953-9179-ddc01899c7f2",
          "migrations_dir": "migrations",
        },
      ],
      // Phase 3 Preview queue bindings (planned resource names per
      // ADR-0016/ADR-0036; blueprint §4 binding names JOBS + DLQ producer).
      // DECLARED here, PROVISIONED by the operator runbook only — this
      // repository pass creates no resources. The producer binding name JOBS
      // is fixed by the blueprint; DLQ is the sanctioned second producer for
      // bounded safe dead-letter references. Consumer options use only
      // documented Wrangler fields.
      "queues": {
        "producers": [
          { "binding": "JOBS", "queue": "pixel-jobs-preview" },
          { "binding": "DLQ", "queue": "pixel-dlq-preview" },
        ],
        "consumers": [
          {
            "queue": "pixel-jobs-preview",
            "dead_letter_queue": "pixel-dlq-preview",
            "max_retries": 3,
            "max_batch_size": 10,
            "max_batch_timeout": 5,
          },
        ],
      },
    },
  },
}
