# Pixel — environment variable reference (Phase 0)
#
# This file documents variable NAMES only. It is NOT read by the Worker or by
# wrangler; it exists so contributors can see the configuration surface.
#
# Rules (docs/SECURITY_MODEL.md):
#   - Non-secret configuration for deployed Workers lives in wrangler.jsonc [vars].
#   - Secret values are provided ONLY via `wrangler secret put <NAME>` or the
#     Cloudflare dashboard. Locally, use a git-ignored `.dev.vars` file
#     (see .dev.vars.example).
#   - NEVER commit real values or token-like placeholders anywhere in the repo.

# --- Non-secret configuration (bound in wrangler.jsonc vars) -------------------
# Deployment environment: development | preview | production
ENVIRONMENT=development
# Minimum log level: debug | info | warn | error
LOG_LEVEL=info
# Build/version marker reported by /health and /version (kept in sync with
# package.json and wrangler.jsonc; enforced by npm run check:versions).
APP_VERSION=1.23.0
# Commit identifier reported by /version (Phase 1A build metadata, ADR-0020).
# Non-secret. "local-dev" is the documented local default and is valid ONLY in
# the development environment. Preview AND production deployments must set the
# real commit identifier: a hexadecimal Git commit ID of 7–64 characters.
APP_COMMIT=local-dev
# Expected D1 schema version (migrations 0001+0002+0003 — ADR-0019/0030/0036).
# Strict positive decimal integer string; invalid values make readiness fail
# closed (never coerced).
SCHEMA_VERSION=6
# Phase 2A Telegram ingress flag (non-secret; ADR-0024). The webhook route
# fails closed unless this is "true" AND the Phase 2 secrets below are set.
# Phase 2A ships with "false": no secrets are configured anywhere.
TELEGRAM_INGRESS_ENABLED=false
# Phase 3 durable job/queue engine flag (non-secret; ADR-0036). Cron dispatch
# and queue consumption are active ONLY while this is "true" AND the required
# queue bindings exist (missing bindings fail closed). Ships "false"; see
# docs/RUNBOOK_PHASE3_QUEUE_SETUP.md before preview activation.
JOBS_ENABLED=false
# Phase 5A editorial source→draft gate (non-secret; ADR-0042). Gates the
# editorial.prepare_draft job type ONLY — never the jobs engine, never AI
# activation. Ships "false": while off, editorial work is losslessly
# policy-paused and the AI service keeps its own independent gates.
EDITORIAL_ENABLED=false
# Phase 5C-4 candidate-MATCHING report gate (V4 Phase 5.2; non-secret).
# Independent fail-closed flag: while off, no candidateMatching payload is
# computed or stored; while on, it is a pure zero-SQL/zero-cost derivation
# of the discovery + assessment of the same commit. Never implies
# EDITORIAL_ENABLED or AI_ENABLED.
EDITORIAL_MATCHING_ENABLED=false
EDITORIAL_ADJUDICATION_ENABLED=false
# Target channel username — NON-SECRET configuration (ADR-0009):
# the public channel username is not credential material.
# Format: @ + 5-32 chars, starts with a letter, ends with letter/digit.
# Intended owner value since R1.10.5 (owner channel identity: pixel lores):
# TARGET_CHANNEL=@pixellores
# Phase 6 AI adapter gates (non-secret; ADR-0041). FAIL-CLOSED defaults:
# with AI_ENABLED=false the AI draft service is the typed deferred
# `ai_disabled` outcome — zero provider calls, zero budget writes.
# AI_GEMINI_ENABLED additionally requires verified Free-tier eligibility
# (unverified in this round — the fallback stays OFF either way).
AI_ENABLED=false
AI_GEMINI_ENABLED=false
# R1.17 event-relation task gate (non-secret; ADR-0045). INDEPENDENT
# fail-closed flag: with false the relation step performs zero retrieval,
# zero adjudication, zero writes; never implies AI/EDITORIAL gates.
EVENT_RELATION_ENABLED=false
# R1.18 read-only admin review gate (non-secret; ADR-0046). INDEPENDENT
# fail-closed flag for the /drafts read-only Telegram surface and its
# help advertisement: with false the commands keep their unknown-command
# noop semantics with zero editorial queries; never implies AI/EDITORIAL/
# ingestion/relation gates, the Telegram ingress itself, or any write path.
ADMIN_REVIEW_ENABLED=false
# R1.20-R admin post pipeline gates (independent, fail-closed):
# with ADMIN_POST_ENABLED=false the surface is fully inert (legacy noop
# semantics); with ADMIN_POST_LIVE_PUBLISH_ENABLED=false an approved post
# can NEVER be sent to the real channel.
ADMIN_POST_ENABLED=false
ADMIN_POST_LIVE_PUBLISH_ENABLED=false
# R1.22 Phase A editorial→post bridge gate (non-secret; independent,
# fail-closed): gates ONLY the /post_from_draft conversion of a stored READY
# editorial draft into an admin post version (durable provenance, no
# fabrication). It can never enable the capture surface or any send by
# itself; the live-publish gate always separately gates the send.
EDITORIAL_TO_POST_ENABLED=false

# --- Secret names: Phase 2 formats (values stay EMPTY until their phase) ------
# Phase 2 contract (ADR-0024): while TELEGRAM_INGRESS_ENABLED is "true",
# BOT_TOKEN, WEBHOOK_SECRET and OWNER_TELEGRAM_ID are REQUIRED and readiness
# fails closed when any of them is missing or invalid. Fake test fixtures
# satisfy the documented formats; real values are `wrangler secret put` only.
# BOT_TOKEN=          # "<bot id>:<token body>" — structural format only
# WEBHOOK_SECRET=     # >= 32 chars of [A-Za-z0-9_-] (max 256)
# OWNER_TELEGRAM_ID=  # positive decimal integer (safe-integer range)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# YOUTUBE_API_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# GITHUB_TOKEN=
# BLUESKY_APP_PASSWORD=
