# Pixel — environment variable reference (Phase 0)
#
# This file documents variable NAMES only. It is NOT read by the Worker or by
# wrangler; it exists so contributors can see the configuration surface.
#
# Rules (docs/SECURITY_MODEL.md):
#   - Non-secret configuration for deployed Workers lives in wrangler.jsonc [vars].
#   - Secret values are provided ONLY via `wrangler secret put <NAME>` or the
#     Cloudflare dashboard. Locally, use a git-ignored `.dev.vars` file
#     (see .dev.vars.example).
#   - NEVER commit real values or token-like placeholders anywhere in the repo.

# --- Non-secret configuration (bound in wrangler.jsonc vars) -------------------
# Deployment environment: development | preview | production
ENVIRONMENT=development
# Minimum log level: debug | info | warn | error
LOG_LEVEL=info
# Build/version marker reported by /health and /version (kept in sync with
# package.json and wrangler.jsonc; enforced by npm run check:versions).
APP_VERSION=1.3.0
# Commit identifier reported by /version (Phase 1A build metadata, ADR-0020).
# Non-secret. "local-dev" is the documented local default and is valid ONLY in
# the development environment. Preview AND production deployments must set the
# real commit identifier: a hexadecimal Git commit ID of 7–64 characters.
APP_COMMIT=local-dev
# Expected D1 schema version (migrations 0001+0002+0003 — ADR-0019/0030/0036).
# Strict positive decimal integer string; invalid values make readiness fail
# closed (never coerced).
SCHEMA_VERSION=3
# Phase 2A Telegram ingress flag (non-secret; ADR-0024). The webhook route
# fails closed unless this is "true" AND the Phase 2 secrets below are set.
# Phase 2A ships with "false": no secrets are configured anywhere.
TELEGRAM_INGRESS_ENABLED=false
# Phase 3 durable job/queue engine flag (non-secret; ADR-0036). Cron dispatch
# and queue consumption are active ONLY while this is "true" AND the required
# queue bindings exist (missing bindings fail closed). Ships "false"; see
# docs/RUNBOOK_PHASE3_QUEUE_SETUP.md before preview activation.
JOBS_ENABLED=false
# Target channel username — NON-SECRET configuration (ADR-0009):
# the public channel username is not credential material.
# Format: @ + 5-32 chars, starts with a letter, ends with letter/digit.
# TARGET_CHANNEL=

# --- Secret names: Phase 2 formats (values stay EMPTY until their phase) ------
# Phase 2 contract (ADR-0024): while TELEGRAM_INGRESS_ENABLED is "true",
# BOT_TOKEN, WEBHOOK_SECRET and OWNER_TELEGRAM_ID are REQUIRED and readiness
# fails closed when any of them is missing or invalid. Fake test fixtures
# satisfy the documented formats; real values are `wrangler secret put` only.
# BOT_TOKEN=          # "<bot id>:<token body>" — structural format only
# WEBHOOK_SECRET=     # >= 32 chars of [A-Za-z0-9_-] (max 256)
# OWNER_TELEGRAM_ID=  # positive decimal integer (safe-integer range)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# YOUTUBE_API_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# GITHUB_TOKEN=
# BLUESKY_APP_PASSWORD=
